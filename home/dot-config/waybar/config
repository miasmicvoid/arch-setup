{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "height": 48,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 18,
  "margin-right": 18,
  "tooltip": true,
  "tooltip-delay": 100,

  "modules-left": [
    "hyprland/workspaces",
    "sway/workspaces"
  ],
  "modules-center": [
    "cpu",
    "memory",
    "disk",
    "temperature",
    "custom/fanspeed",
    "pulseaudio",
    "network"
  ],
  "modules-right": [
    "tray",
    "battery",
    "clock"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "tooltip": true,
    "format": "{name}"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "cpu": {
    "format": " {usage:>2}%",
    "min-length": 4,
    "interval": 5,
    "states": {
      "critical": 90
    },
    "tooltip": true
  },

  "memory": {
    "format": "󰘚 {percentage:>2}%",
    "min-length": 4,
    "interval": 5,
    "states": {
      "critical": 100
    },
    "tooltip": true,
    "tooltip-format": "Used: {used:0.1f}GiB / {total:0.1f}GiB"
  },

  "disk": {
    "format": " {percentage_used:>2}%",
    "min-length": 4,
    "path": "/",
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "Disk: {used} used out of {total}"
  },

  "temperature": {
    "critical-threshold": 98,
    "format": "{icon} {temperatureC:>2}°C",
    "min-length": 5,
    "hwmon-path": "/sys/class/thermal/thermal_zone3/temp",
    "format-icons": ["", "", "", ""],
    "tooltip": true
  },

  "custom/fanspeed": {
    "exec": "nbfc status -a | grep 'Current Fan Speed' | awk '{print int($5)}'",
    "interval": 5,
    "min-length": 4,
    "format": "󰈐 {0:>3}%",
    "tooltip": false
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity:>2}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{timeTo} ({capacity}%)",
    "min-length": 4
  },
  "pulseaudio": {
    "format": "{icon} {volume:>2}%",
    "format-bluetooth": "{icon}󰂰 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "󱡒",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pgrep pavucontrol >/dev/null 2>&1 && killall pavucontrol || pavucontrol",
    "tooltip-format": "{icon} {desc} | {volume}%"
  },
  "network": {
    "format": "󰇚 {bandwidthDownBytes:>2} 󰕒 {bandwidthUpBytes:>2}",
    "format-disconnected": "󰲜 Disconnected",
    "interval": 5,
    "tooltip": true,
    "tooltip-format-wifi": "IP: {ipaddr}\nSignal: {signalStrength}%\nNetwork: {essid}",
    "tooltip-format-ethernet": "IP: {ipaddr}\nSignal: {signalStrength}%\nNetwork: Ethernet",
    "min-length": 20,
    "on-click": "pgrep nm-applet >/dev/null 2>&1 && killall nm-applet || nm-applet"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10
  },

  "clock": {
    "format": "{:%R - %d.%m.}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ac82e9'><b>{}</b></span>",
        "days": "<span color='#d8cab8'><b>{}</b></span>",
        "weekdays": "<span color='#ac82e9'><b>{}</b></span>",
        "today": "<span color='#141216' background='#ac82e9'><b>{}</b></span>"
      }
    }
  }
}